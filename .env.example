# ---- Docker 映像（僅 docker-compose 使用）----
# 預設官方映像；想固定版本或回滾可改成 zichuanlan/freebie-radar:v1.1.0 或某個 git 短 SHA
RADAR_IMAGE=zichuanlan/freebie-radar:latest

# ---- 雲端提示詞（可選）----
# 指向 raw 的 Markdown；留空則用程式碼內建的 DEFAULT_PROMPT。
# 改這裡指向的儲存庫即可調整審核口徑，不用發版；拉取失敗會保留上一版。
# 預設關閉：自部署時指向你自己的提示詞儲存庫再取消注釋（上遊那份是站長的口徑，不一定適合你）
# PROMPT_URL=https://raw.githubusercontent.com/<you>/<repo>/main/system.md
# PROMPT_EXTRA_URL=https://raw.githubusercontent.com/<you>/<repo>/main/extra.md
# 輪詢間隔（分鍾）；0 = 只在啟動時同步一次
# PROMPT_SYNC_MINUTES=10
# ---- 基礎服務 ----
PORT=8788
HOST=0.0.0.0
# 資料庫路徑（本地相對專案根，Docker 預設 /data/radar.db）
DATABASE_PATH=./data/radar.db
TZ=Asia/Taipei

# ---- 安全與管理鑑權 ----
# 管理區密碼（控制推播/AI/訂閱封鎖/資料來源維運與專案標記）。
# 留空僅在非生產 selfhost 下開放；公開站及 production 下管理區鎖定！
ADMIN_TOKEN=
# 管理 API 可選專用網域（Host，可帶連線埠；逗號分隔），留空相容單網域
ADMIN_HOSTS=
# 只在源站連線埠已封口且反代會覆蓋 X-Forwarded-For 後開啟
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
# Docker 對宿主機預設僅回環發布；遠端直連需顯式修改，不建議公網直連
BIND_ADDRESS=127.0.0.1
# 僅 selfhost 可按需允許內網 Webhook；公開站始終拒絕內網
WEBHOOK_ALLOW_PRIVATE=false

# ---- 網路與代理（按需填寫） ----
# 擷取在海外伺服器跑時可留空；國內本機除錯可填 HTTP 代理（如 http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=
FETCH_TIMEOUT_MS=20000
MIN_REQUEST_GAP_MS=2000
SOURCE_GAP_MS=3000

# ---- Cloudflare 繞過（可選） ----
# 若啟用 docker compose --profile cf，填 http://flaresolverr:8191 ；留空則直連
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT_MS=60000

# ---- 擷取控制 ----
# 逗號分隔只跑指定源，留空表示按 DB 啟停設定跑全部啟用源
KIBIS_SOURCE_PROFILE=taiwan
ENABLED_SOURCES=
MAX_ITEMS_PER_RUN=50
# 可選：GitHub API Token，將限額從 60/h 提到 5000/h
GITHUB_TOKEN=

# ---- 定時排程 ----
ENABLE_SCHEDULER=true
COLLECT_CRON=0 */2 * * *
DAILY_CRON=30 8 * * *
DAILY_TOP_N=12
PUBLIC_BASE_URL=

# ---- Telegram 推播（可選） ----
# none = 僅網頁檢視；telegram = 開啟 Telegram 即時/攢批/日報推播
PUSH_CHANNEL=none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PROXY=

# ---- AI 語義審核（可選 · 僅首次初始化預設值，後續直接在網頁「AI 引擎」熱設定） ----
# 支援任意 OpenAI 相容介面（如 DeepSeek / OpenAI / OneAPI / NewAPI 等）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_ITEMS=60

# ---- 登入態站點回傳（知乎 / 小紅書 / 小黑盒 · 可選） ----
# 配合 scripts/pw-collect.mjs 使用；留空則 /api/ingest 拒絕外部寫入
INGEST_TOKEN=

# ---- 站點形態與多使用者（公開站才需要，單人自建可整段留空） ----
# auto = 配齊任一 OAuth 渠道憑據就按公開站跑，否則按單人自建
# selfhost = 強制單人自建（全域性收藏/封鎖，行為與舊版一致）
# public   = 公開站：公共內容只讀共享，個人狀態按登入使用者隔離
SITE_MODE=auto

# LINUX DO Connect OAuth2（在 https://connect.linux.do 申請，回撥填 <站點>/api/auth/linuxdo/callback）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 不填則按 PUBLIC_BASE_URL 或請求 Host 自動推導
LINUXDO_REDIRECT_URI=
# 登入所需最低信任等級（0-4），後台還能再熱改
LINUXDO_MIN_TRUST_LEVEL=0
# 僅 OAuth 用的代理（國內網路直連 connect.linux.do 常被汙染/阻斷）；
# 留空則回退 HTTP_PROXY / HTTPS_PROXY。設了它不會影響擷取走代理。
LINUXDO_PROXY=

# ---- GitHub 登入（可選，與 LINUX DO 並存） ----
# OAuth App 回撥必須逐字元一致：線上 https://你的網域/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 留空則由 PUBLIC_BASE_URL + /api/auth/github/callback 推導
GITHUB_REDIRECT_URI=
# 僅 GitHub OAuth 用的代理；留空回退 LINUXDO_PROXY → HTTP(S)_PROXY
GITHUB_PROXY=

# Session 與個人 Bot Token 加密金鑰（留空則首次啟動自動生成並寫入 settings 表）
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# 本地模擬登入（僅 NODE_ENV=development + 回環 Host + 顯式 true 時生效）
AUTH_DEV_MOCK=false

# 個人推播護欄：單使用者每小時 / 每輪即時上限
USER_PUSH_MAX_PER_HOUR=40
USER_PUSH_MAX_PER_INSTANT=5

# ---- 版本檢測與一鍵更新（可選） ----
SELF_UPDATE_REMOTE=origin
SELF_UPDATE_BRANCH=main
# 更新完成後執行的命令；留空則程序自行退出，交給 systemd / pm2 / docker restart 拉起
SELF_UPDATE_RESTART_CMD=
# 容器部署時可指向宿主機更新指令碼（POST 一次即觸發重建映像）
UPDATE_WEBHOOK_URL=
UPDATE_WEBHOOK_TOKEN=
# 容器構建時注入，便於在後台顯示目前執行的提交
APP_COMMIT=
APP_BUILD_TIME=
APP_REPO=JingFeng-code/AstraKibis
